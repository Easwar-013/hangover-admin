# Same database as the customer site
MONGODB_URI=

# Auth for THIS site (use a different secret from the customer site)
NEXTAUTH_URL=https://admin.your-domain.com
NEXTAUTH_SECRET=

# The single admin account (run: node scripts/hash-password.mjs "password")
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Link back to the customer site (used by "View Storefront" and stock-alert emails)
NEXT_PUBLIC_STOREFRONT_URL=https://your-store.vercel.app
STOREFRONT_URL=https://your-store.vercel.app

# Same values as the customer site (back-in-stock emails)
GMAIL_USER=
GMAIL_APP_PASS=
